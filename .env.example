# ---------------------------------------------------------------------------
# Nexora — example environment for local development and for Vercel.
#
# DO NOT COMMIT A REAL .env FILE. Copy this to `.env.local` for local work and
# set the values in the Vercel project's Environment Variables for deployment.
# Nothing here is a real secret; every value is a placeholder.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Local:  postgres://nexora:nexora@localhost:5432/nexora_dev
# Vercel: use a POOLED endpoint (Neon pooler / PgBouncer / Supabase pooler).
# A serverless function may run many instances at once, each with its own pool,
# so the pooled endpoint is what keeps the database from being overwhelmed.
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora_dev
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
# url | verify-full | disable   ("url" = let DATABASE_URL's sslmode= decide)
DATABASE_SSL=url

# --- Security --------------------------------------------------------------
# PRODUCTION REQUIRES REAL VALUES. config/env.ts refuses to boot in production
# while any secret below still starts with "nexora-dev".
# Generate each with:  openssl rand -base64 48
JWT_SECRET=nexora-dev-secret-change-me
EVIDENCE_ENCRYPTION_KEY=nexora-dev-evidence-key-change-me
FACE_CAPTURE_PROOF_SECRET=nexora-dev-face-capture-proof-change
LIVE_CAPTURE_PROOF_SECRET=nexora-dev-live-capture-proof-change
# RULE 20.4.1 — must differ from EVIDENCE_ENCRYPTION_KEY, and is REQUIRED in production.
BACKUP_ENCRYPTION_KEY=

# --- Frontend origins -------------------------------------------------------
# Comma-separated. Include every deployed frontend origin that calls the API.
# The company portal is same-origin, so it normally needs no CORS grant; the
# Platform Owner console is a separate project and DOES need one.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Frontend build-time variables (Vite) ----------------------------------
# Leave EMPTY for the company portal when the API is same-origin (the default
# and recommended setup). Set only when the API is on a different origin.
VITE_API_BASE_URL=
# For the Platform Owner console, set this to the deployed API origin, e.g.
# VITE_PLATFORM_API_BASE_URL=https://nexora-api.example.com

# --- Platform address (Vision Part 1 §2.3) ----------------------------------
# The URL law fixes the SLUG (created once, unique platform-wide, derived from the
# company name). These three variables decide which address form that slug is
# published as. All three address forms RESOLVE at runtime — these only decide
# what the Platform Owner is shown in the one-time credential panel.
#
# PLATFORM_APEX  the apex a generated subdomain is built from.
#                The Vision's example is `nexora.app`.
# PLATFORM_BASE_URL  the origin this deployment is actually served from, e.g.
#                https://myplatform.vercel.app
# COMPANY_URL_MODE  `subdomain` publishes {slug}.{PLATFORM_APEX} and requires a
#                wildcard DNS record pointed at this deployment. `path` publishes
#                {PLATFORM_BASE_URL}/{slug}, which works on any host including
#                Vercel's *.vercel.app (no user subdomains are issued there).
PLATFORM_APEX=nexora.app
PLATFORM_BASE_URL=http://localhost:5173
# Vercel deployments: use `path` unless a wildcard domain is pointed here.
COMPANY_URL_MODE=path

# --- Storage / backup ------------------------------------------------------
EVIDENCE_STORAGE_ROOT=
BACKUP_WORK_ROOT=
BACKUP_POLICY_PATH=
