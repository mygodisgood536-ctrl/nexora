{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "npm run build --workspace=packages/web",
  "outputDirectory": "packages/web/dist",
  "functions": {
    "api/nexora-api.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/nexora-api" },
    { "source": "/platform/v1/:poPath*", "destination": "/api/nexora-api" },
    { "source": "/:tenant/api/v1/:path*", "destination": "/api/nexora-api" },
    { "source": "/:tenant/platform/v1/:poPath*", "destination": "/api/nexora-api" },
    { "source": "/((?!api/|platform/).*)", "destination": "/index.html" }
  ]
}
